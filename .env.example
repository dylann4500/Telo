# Telo configuration. Copy to .env.local (`npm run setup` does it and fills
# in the generated values). Anything left empty falls back to the local
# simulation, so the app runs end to end with no keys at all.

# ---------------------------------------------------------------- you
# Your name as Telo says it on calls, and your mobile in E.164. Texts and
# calls from this number are treated as you.
TELO_USER_NAME=Dylan
TELO_USER_PHONE=
# Where proactive updates go: sms | imessage | whatsapp | voice | web.
# Replies always go back on the channel you wrote from.
TELO_USER_CHANNEL=sms
TELO_TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------- Claude
# Reasoning: understanding requests, planning calls, reading transcripts.
# Without a key, a rule-based stand-in handles the demo scenarios.
ANTHROPIC_API_KEY=
TELO_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Dial
# Phone numbers, calls and texts (https://getdial.ai). Set DIAL_API_KEY,
# then `npm run dial:setup` fills in the rest of this block.
DIAL_API_KEY=
DIAL_NUMBER_ID=
TELO_PHONE_NUMBER=
DIAL_WEBHOOK_SECRET=
# Public HTTPS address of this app, for Dial's webhooks and mid-call tools.
# `npm run tunnel` sets it to a Cloudflare quick tunnel.
PUBLIC_BASE_URL=
# Shared secret Dial sends to Telo's MCP endpoint (generated by npm run setup).
TELO_MCP_TOKEN=
# Calls are capped at 5 minutes on a free Dial account; max 3600 after a top-up.
TELO_MAX_CALL_SECONDS=300
# Put a live status digest in the inbound call prompt (single-user demo aid).
TELO_INBOUND_STATUS_IN_PROMPT=true

# ---------------------------------------------------------------- Keewano
# Event memory (https://keewano.com). Writes use the project's SDK-type API
# key; reads use your personal access token over Keewano's SQL endpoint.
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
KEEWANO_PG_USER=
# Secret UUID namespace for entity ids (generated by npm run setup).
TELO_ENTITY_NAMESPACE=

# ---------------------------------------------------------------- demo
# The "business" in a live demo is a teammate's phone. Any business without
# a number of its own is dialed here.
DEMO_TARGET_PHONE=
# Override or extend the business directory, e.g.
# TELO_DIRECTORY=[{"name":"Comcast","phone":"+14155550101"}]
TELO_DIRECTORY=
# Demo controls in the dashboard (seed history, simulate calls, reset).
TELO_DEV_TOOLS=true
# Playback speed of simulated calls.
MOCK_CALL_SPEED=1

# ---------------------------------------------------------------- storage
# SQLite file locally; a libsql:// URL (Turso) for a hosted database.
DATABASE_URL=file:./data/telo.db
DATABASE_AUTH_TOKEN=

# Force a provider instead of picking from which keys are set:
# LLM_PROVIDER=anthropic|mock  VOICE_PROVIDER=dial|mock  MEMORY_PROVIDER=keewano|local
